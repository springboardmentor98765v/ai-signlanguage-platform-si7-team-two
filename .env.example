# ============================================================
# .env.example — contract env vars for the sign language platform.
#
# Milestone 1 (Days 1-5): database, auth, AI service URLs.
# Milestone 2 (Day 7): added email + certificate vars.
#
# Copy to `.env` — never commit the real `.env` to Git.
# ============================================================

# --- Database (Data Layer) ---
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=signlang_platform
DB_USER=signlang_app
DB_PASSWORD=changeme_on_day2
DATABASE_URL=postgresql://signlang_app:changeme_on_day2@localhost:5432/signlang_platform

# --- Auth (contract with Intern 2, needed by Day 4) ---
JWT_SECRET_KEY=changeme_generate_a_real_secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- AI Service (contract with Intern 3, needed by Day 6) ---
AI_SERVICE_URL=http://localhost:8001

# --- Backend API (contract with Intern 2) ---
BACKEND_API_URL=http://localhost:8000

# --- Email / Forgot-Password flow (NEW — Milestone 2, backend Day 2) ---
# Free option: Gmail account with an App Password (generate at
# myaccount.google.com/apppasswords — not your normal Gmail password).
# If left blank the backend falls back to printing the reset link to
# the console, which is fine for local testing.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_FROM_ADDRESS=noreply@example.com

# --- Certificate generation (NEW — Milestone 2, business-logic Day 7) ---
# Intern 4: read these in your PDF-generation service.
CERTIFICATE_OUTPUT_DIR=/app/generated_certificates
CERTIFICATE_TEMPLATE_NAME=default
