# Copy this file to .env and adjust if your ports differ.

# Intern 2's gateway — auth, lessons, instructor, AI predict, assessment/score (proxied)
VITE_API_BASE_URL=http://localhost:8000

# Intern 4's Business Logic service — analytics, weekly-analytics, recommendations,
# progress-report, certificates. NOT included in docker-compose.yml today — someone
# must run it separately, e.g.:
#   cd Bussiness_Logic && uvicorn main:app --port 8002
VITE_BUSINESS_LOGIC_URL=http://localhost:8002
